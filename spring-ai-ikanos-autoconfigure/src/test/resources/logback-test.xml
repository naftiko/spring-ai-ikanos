<?xml version="1.0" encoding="UTF-8"?>
<!-- Takes precedence over the logback.xml bundled inside ikanos-engine, which references an
     OpenTelemetry appender that is not on this classpath. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.ikanos" level="WARN"/>
    <logger name="org.restlet" level="WARN"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
